{
  "name": "@veritygrid/api",
  "version": "0.2.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker:dev": "tsx watch src/worker.ts",
    "worker": "node dist/worker.js"
  },
  "dependencies": {
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.0.0",
    "zod": "^4.6.7",
    "bullmq": "^6.7.8",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "prisma": "6.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "vitest": "^5.1.1"
  }
}
